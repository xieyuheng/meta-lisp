(claim term-t meta-builtin/builtin/type-t)

(define-enum term-t
  (var-term (name meta-builtin/builtin/symbol-t))
  (apply-term (target self/lambda/term-t) (arg self/lambda/term-t))
  (lambda-term
   (parameter meta-builtin/builtin/symbol-t)
   (body self/lambda/term-t))
  (let-term
   (name meta-builtin/builtin/symbol-t)
   (rhs self/lambda/term-t)
   (body self/lambda/term-t)))

(claim var-term (-> meta-builtin/builtin/symbol-t term-t))

(define (var-term name)
  (let ((array (meta-builtin/builtin/make-array)))
    (begin
      (meta-builtin/builtin/array-push var-term array)
      (begin (meta-builtin/builtin/array-push name array) array))))

(claim is-var-term (-> term-t meta-builtin/builtin/bool-t))

(define (is-var-term value)
  (if (meta-builtin/builtin/is-array value)
    (if (meta-builtin/builtin/equal (meta-builtin/builtin/array-length value) 2)
      (meta-builtin/builtin/equal
       (meta-builtin/builtin/array-get 0 value)
       var-term)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(claim var-term-name (-> term-t meta-builtin/builtin/symbol-t))

(define (var-term-name target) (meta-builtin/builtin/array-get 1 target))

(claim var-term-put-name (-> meta-builtin/builtin/symbol-t term-t term-t))

(define (var-term-put-name value target)
  (begin (meta-builtin/builtin/array-put 1 value target) target))

(claim apply-term (-> term-t term-t term-t))

(define (apply-term target arg)
  (let ((array (meta-builtin/builtin/make-array)))
    (begin
      (meta-builtin/builtin/array-push apply-term array)
      (begin
        (meta-builtin/builtin/array-push target array)
        (begin (meta-builtin/builtin/array-push arg array) array)))))

(claim is-apply-term (-> term-t meta-builtin/builtin/bool-t))

(define (is-apply-term value)
  (if (meta-builtin/builtin/is-array value)
    (if (meta-builtin/builtin/equal (meta-builtin/builtin/array-length value) 3)
      (meta-builtin/builtin/equal
       (meta-builtin/builtin/array-get 0 value)
       apply-term)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(claim apply-term-target (-> term-t term-t))

(define (apply-term-target target) (meta-builtin/builtin/array-get 1 target))

(claim apply-term-put-target (-> term-t term-t term-t))

(define (apply-term-put-target value target)
  (begin (meta-builtin/builtin/array-put 1 value target) target))

(claim apply-term-arg (-> term-t term-t))

(define (apply-term-arg target) (meta-builtin/builtin/array-get 2 target))

(claim apply-term-put-arg (-> term-t term-t term-t))

(define (apply-term-put-arg value target)
  (begin (meta-builtin/builtin/array-put 2 value target) target))

(claim lambda-term (-> meta-builtin/builtin/symbol-t term-t term-t))

(define (lambda-term parameter body)
  (let ((array (meta-builtin/builtin/make-array)))
    (begin
      (meta-builtin/builtin/array-push lambda-term array)
      (begin
        (meta-builtin/builtin/array-push parameter array)
        (begin (meta-builtin/builtin/array-push body array) array)))))

(claim is-lambda-term (-> term-t meta-builtin/builtin/bool-t))

(define (is-lambda-term value)
  (if (meta-builtin/builtin/is-array value)
    (if (meta-builtin/builtin/equal (meta-builtin/builtin/array-length value) 3)
      (meta-builtin/builtin/equal
       (meta-builtin/builtin/array-get 0 value)
       lambda-term)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(claim lambda-term-parameter (-> term-t meta-builtin/builtin/symbol-t))

(define (lambda-term-parameter target)
  (meta-builtin/builtin/array-get 1 target))

(claim lambda-term-put-parameter
  (-> meta-builtin/builtin/symbol-t term-t term-t))

(define (lambda-term-put-parameter value target)
  (begin (meta-builtin/builtin/array-put 1 value target) target))

(claim lambda-term-body (-> term-t term-t))

(define (lambda-term-body target) (meta-builtin/builtin/array-get 2 target))

(claim lambda-term-put-body (-> term-t term-t term-t))

(define (lambda-term-put-body value target)
  (begin (meta-builtin/builtin/array-put 2 value target) target))

(claim let-term (-> meta-builtin/builtin/symbol-t term-t term-t term-t))

(define (let-term name rhs body)
  (let ((array (meta-builtin/builtin/make-array)))
    (begin
      (meta-builtin/builtin/array-push let-term array)
      (begin
        (meta-builtin/builtin/array-push name array)
        (begin
          (meta-builtin/builtin/array-push rhs array)
          (begin (meta-builtin/builtin/array-push body array) array))))))

(claim is-let-term (-> term-t meta-builtin/builtin/bool-t))

(define (is-let-term value)
  (if (meta-builtin/builtin/is-array value)
    (if (meta-builtin/builtin/equal (meta-builtin/builtin/array-length value) 4)
      (meta-builtin/builtin/equal
       (meta-builtin/builtin/array-get 0 value)
       let-term)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(claim let-term-name (-> term-t meta-builtin/builtin/symbol-t))

(define (let-term-name target) (meta-builtin/builtin/array-get 1 target))

(claim let-term-put-name (-> meta-builtin/builtin/symbol-t term-t term-t))

(define (let-term-put-name value target)
  (begin (meta-builtin/builtin/array-put 1 value target) target))

(claim let-term-rhs (-> term-t term-t))

(define (let-term-rhs target) (meta-builtin/builtin/array-get 2 target))

(claim let-term-put-rhs (-> term-t term-t term-t))

(define (let-term-put-rhs value target)
  (begin (meta-builtin/builtin/array-put 2 value target) target))

(claim let-term-body (-> term-t term-t))

(define (let-term-body target) (meta-builtin/builtin/array-get 3 target))

(claim let-term-put-body (-> term-t term-t term-t))

(define (let-term-put-body value target)
  (begin (meta-builtin/builtin/array-put 3 value target) target))

(claim env-t meta-builtin/builtin/type-t)

(define-opaque-type env-t
    (meta-builtin/builtin/hash-t
     meta-builtin/builtin/symbol-t
     self/lambda/value-t)
  (empty-env (-> self/lambda/env-t))
  (extend-env
   (-> meta-builtin/builtin/symbol-t
       self/lambda/value-t
       self/lambda/env-t
       self/lambda/env-t))
  (env-lookup
   (-> meta-builtin/builtin/symbol-t
       self/lambda/env-t
       (meta-builtin/builtin/maybe-t self/lambda/value-t))))

(claim empty-env (-> env-t))

(define empty-env meta-builtin/builtin/make-hash)

(claim extend-env (-> meta-builtin/builtin/symbol-t value-t env-t env-t))

(define extend-env meta-builtin/builtin/hash-copy-put)

(claim env-lookup
  (-> meta-builtin/builtin/symbol-t env-t (meta-builtin/builtin/maybe-t value-t)))

(define env-lookup meta-builtin/builtin/hash-get-maybe)

(claim value-t meta-builtin/builtin/type-t)

(define-enum value-t
  (closure-value
   (env self/lambda/env-t)
   (parameter meta-builtin/builtin/symbol-t)
   (body self/lambda/term-t)))

(claim closure-value (-> env-t meta-builtin/builtin/symbol-t term-t value-t))

(define (closure-value env parameter body)
  (let ((array (meta-builtin/builtin/make-array)))
    (begin
      (meta-builtin/builtin/array-push closure-value array)
      (begin
        (meta-builtin/builtin/array-push env array)
        (begin
          (meta-builtin/builtin/array-push parameter array)
          (begin (meta-builtin/builtin/array-push body array) array))))))

(claim is-closure-value (-> value-t meta-builtin/builtin/bool-t))

(define (is-closure-value value)
  (if (meta-builtin/builtin/is-array value)
    (if (meta-builtin/builtin/equal (meta-builtin/builtin/array-length value) 4)
      (meta-builtin/builtin/equal
       (meta-builtin/builtin/array-get 0 value)
       closure-value)
      meta-builtin/builtin/false)
    meta-builtin/builtin/false))

(claim closure-value-env (-> value-t env-t))

(define (closure-value-env target) (meta-builtin/builtin/array-get 1 target))

(claim closure-value-put-env (-> env-t value-t value-t))

(define (closure-value-put-env value target)
  (begin (meta-builtin/builtin/array-put 1 value target) target))

(claim closure-value-parameter (-> value-t meta-builtin/builtin/symbol-t))

(define (closure-value-parameter target)
  (meta-builtin/builtin/array-get 2 target))

(claim closure-value-put-parameter
  (-> meta-builtin/builtin/symbol-t value-t value-t))

(define (closure-value-put-parameter value target)
  (begin (meta-builtin/builtin/array-put 2 value target) target))

(claim closure-value-body (-> value-t term-t))

(define (closure-value-body target) (meta-builtin/builtin/array-get 3 target))

(claim closure-value-put-body (-> term-t value-t value-t))

(define (closure-value-put-body value target)
  (begin (meta-builtin/builtin/array-put 3 value target) target))

(define (evaluate term env)
  (if (self/lambda/is-var-term term)
    (let ((name (self/lambda/var-term-name term)))
      (if (meta-builtin/builtin/is-just (self/lambda/env-lookup name env))
        (let
            ((value
              (meta-builtin/builtin/just-value (self/lambda/env-lookup name env))))
          value)
        (if (meta-builtin/builtin/is-nothing (self/lambda/env-lookup name env))
          (meta-builtin/builtin/error-with-location
           "undefined name"
           (meta-builtin/builtin/make-source-location
            "src/lambda.meta"
            (meta-builtin/builtin/make-source-span
             (meta-builtin/builtin/make-source-position 730 25 18)
             (meta-builtin/builtin/make-source-position 754 25 42))))
          (meta-builtin/builtin/error-with-location
           "cond mismatch"
           (meta-builtin/builtin/make-source-location
            "src/lambda.meta"
            (meta-builtin/builtin/make-source-span
             (meta-builtin/builtin/make-source-position 656 23 6)
             (meta-builtin/builtin/make-source-position 661 23 11)))))))
    (if (self/lambda/is-apply-term term)
      (let ((arg (self/lambda/apply-term-arg term)))
        (let ((target (self/lambda/apply-term-target term)))
          (self/lambda/apply
           (self/lambda/evaluate target env)
           (self/lambda/evaluate arg env))))
      (if (self/lambda/is-lambda-term term)
        (let ((body (self/lambda/lambda-term-body term)))
          (let ((parameter (self/lambda/lambda-term-parameter term)))
            (self/lambda/closure-value env parameter body)))
        (if (self/lambda/is-let-term term)
          (let ((body (self/lambda/let-term-body term)))
            (let ((rhs (self/lambda/let-term-rhs term)))
              (let ((name (self/lambda/let-term-name term)))
                (let
                    ((env (self/lambda/extend-env
                           name
                           (self/lambda/evaluate rhs env)
                           env)))
                  (self/lambda/evaluate body env)))))
          (meta-builtin/builtin/error-with-location
           "cond mismatch"
           (meta-builtin/builtin/make-source-location
            "src/lambda.meta"
            (meta-builtin/builtin/make-source-span
             (meta-builtin/builtin/make-source-position 618 21 3)
             (meta-builtin/builtin/make-source-position 623 21 8)))))))))

(define (apply target arg)
  (if (self/lambda/is-closure-value target)
    (let ((body (self/lambda/closure-value-body target)))
      (let ((parameter (self/lambda/closure-value-parameter target)))
        (let ((env (self/lambda/closure-value-env target)))
          (self/lambda/evaluate body (self/lambda/extend-env parameter arg env)))))
    (meta-builtin/builtin/error-with-location
     "cond mismatch"
     (meta-builtin/builtin/make-source-location
      "src/lambda.meta"
      (meta-builtin/builtin/make-source-span
       (meta-builtin/builtin/make-source-position 1068 35 3)
       (meta-builtin/builtin/make-source-position 1073 35 8))))))