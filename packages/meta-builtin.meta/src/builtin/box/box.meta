(module builtin)

(define-opaque-type (box-t E) (array-t E)
  (make-box (-> (box-t E)))
  (box-is-empty (-> (box-t E) bool-t))
  (box-put (-> E (box-t E) void-t))
  (box-get-maybe (-> (box-t E) (maybe-t E))))

(define (make-box)
  (make-array))

(define (box-is-empty box)
  (array-is-empty box))

(define (box-put value box)
  (if (box-is-empty box)
    (array-push value box)
    (array-put 0 value box)))

(define (box-get-maybe box)
  (if (box-is-empty box)
    (nothing)
    (just (array-get 0 box))))

(claim box-get
  (all (E)
    (-> (box-t E) E)))

(define (box-get box)
  (match (box-get-maybe box)
    ((just value) value)
    ((nothing) (error "box is empty"))))

(claim box-get-with-location
  (all (E)
    (-> (box-t E) source-location-t E)))

(define (box-get-with-location box location)
  (match (box-get-maybe box)
    ((just value) value)
    ((nothing)
     (file-write
      (current-stderr-file)
      (format-message-with-location "box is empty" location))
     (error "box is empty"))))

(define-test box-test
  (let ((box (make-box)))
    (assert (box-is-empty box))
    (assert-equal (nothing) (box-get-maybe box))
    (box-put 42 box)
    (assert-not (box-is-empty box))
    (assert-equal 42 (box-get box))
    (assert-equal (just 42) (box-get-maybe box))))