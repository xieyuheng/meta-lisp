(module builtin)

(define-test array-test
  ;; construction and access

  (let ((a (make-array)))
    (assert (array-is-empty a))
    (array-push 1 a)
    (array-push 2 a)
    (array-push 3 a)
    (assert-not (array-is-empty a))
    (assert-equal 3 (array-length a))
    (assert-equal 1 (array-get 0 a))
    (assert-equal 2 (array-get 1 a))
    (assert-equal 3 (array-get 2 a)))

  ;; put / pop

  (let ((a (make-array)))
    (array-push 1 a)
    (array-put 0 10 a)
    (assert-equal 10 (array-get 0 a))
    (assert-equal 10 (array-pop a))
    (assert (array-is-empty a)))

  ;; push-front / pop-front

  (let ((a (make-array)))
    (array-push 2 a)
    (array-push-front 1 a)
    (assert-equal 1 (array-pop-front a))
    (assert-equal 2 (array-pop-front a))
    (assert (array-is-empty a)))

  ;; copy is not shared

  (let ((a (make-array)))
    (array-push 1 a)
    (let ((b (array-copy a)))
      (array-push 2 a)
      (assert-equal 1 (array-length b))))

  ;; reverse

  (let ((a (make-array)))
    (array-push 1 a)
    (array-push 2 a)
    (array-push 3 a)
    (array-reverse a)
    (assert-equal (@list 3 2 1) (array-to-list a)))

  ;; literal

  (assert (is-array (@array 1 2 3)))
  (assert-equal 3 (array-length (@array 1 2 3)))
  (assert-equal 1 (array-get 0 (@array 1 2 3)))
  (assert-equal (@list 1 2 3) (array-to-list (@array 1 2 3)))

  ;; conversions

  (assert-equal (@list 1 2 3) (array-to-list (list-to-array (@list 1 2 3))))
  (assert (array-is-empty (list-to-array (@list))))

  ;; is-array

  (assert (is-array (make-array)))
  (assert (is-array (list-to-array (@list 1 2 3))))
  (assert-not (is-array (@list 1 2 3)))
  (assert-not (is-array 1)))